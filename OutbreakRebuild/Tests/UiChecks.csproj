<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InputMode Condition="'$(InputMode)' == ''">Legacy</InputMode>
    <DefineConstants Condition="'$(InputMode)' == 'Legacy'">UNITY_EDITOR;ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <DefineConstants Condition="'$(InputMode)' == 'NewOnly'">UNITY_EDITOR;ENABLE_INPUT_SYSTEM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Outbreak/Contracts/*.cs" />
    <Compile Include="../Assets/Outbreak/Core/*.cs" />
    <Compile Include="../Assets/Outbreak/Persistence/*.cs" />
    <Compile Include="../Assets/Outbreak/Unity/*.cs" />
    <Compile Include="../Assets/Outbreak/Editor/InputSetup.cs" />
    <Compile Include="../Assets/Outbreak/Editor/InputDiagnostics.cs" />
    <Compile Include="UiHarness.cs" />
  </ItemGroup>
</Project>
